{
  "name": "santai",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @santai/web --filter @santai/server run dev",
    "build": "pnpm --filter @santai/web run build",
    "start": "pnpm --filter @santai/web run start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @santai/shared run db:generate",
    "db:push": "pnpm --filter @santai/shared run db:push",
    "db:seed": "pnpm --filter @santai/shared run db:seed",
    "db:studio": "pnpm --filter @santai/shared run db:studio"
  },
  "devDependencies": {
    "@santai/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
