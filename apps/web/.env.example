# =============================================
# apps/web — Frontend (Next.js, auto-loaded)
# Copy to .env and fill in values.
# =============================================

# Public URLs (exposed to client)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_API_URL="http://localhost:3001"

# Firebase (client-only, optional)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC2Vo5jPDqbzBv8O0AhMyexCMqvIUeCvmE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="santaiid.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="santaiid"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="santaiid.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="433820027698"
NEXT_PUBLIC_FIREBASE_APP_ID="1:433820027698:web:09202e45340435b9c0e52b"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-YWG4EKZW65"

# Better Auth Sentinel (client, optional)
# Better Auth Sentinel (client) — disabled: sentinelClient adds X-Visitor-Id/X-Request-Id
# headers that the server CORS (apps/server/src/app.ts allowHeaders) rejects.
NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=""

# External data APIs (cron fetchers run inside this app)
GNEWS_API_KEY=""
YOUTUBE_API_KEY=""
LINEAR_API_KEY=""

# ---------------------------------------------------------------------------
# Server-side secrets — MUST mirror apps/server/.env
# The web hosts an in-process Better Auth instance (Server Actions, proxy,
# /api/auth/[...all] fallback) and Prisma, so it needs the same credentials.
# ---------------------------------------------------------------------------

# Database (shared Prisma)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Better Auth secret — MUST match apps/server/.env
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"

# Auth API mount URL (validated by src/env.ts)
BETTER_AUTH_URL="http://localhost:3001"

# Better Auth Infrastructure Dashboard (dash.better-auth.com) — mounts dash() plugin
# Set to activate. MUST mirror apps/server/.env. API key from dash.better-auth.com project settings.
BETTER_AUTH_API_URL="https://dash.better-auth.com"
BETTER_AUTH_API_KEY=""

# Email (OTP / verification)
RESEND_API_KEY="re_..."

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI MU chat (OpenRouter)
# Server-side only; never expose op_key to the client.
# Default model: openrouter/auto (centralized in src/lib/ai/openrouter.ts)
op_key=""

